NODE_ENV=development
PORT=8080

# System DB
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=Zaq123@@
DB_NAME=salesplatform_system

# Tenant DB (if different host)
TENANT_DB_HOST=localhost
