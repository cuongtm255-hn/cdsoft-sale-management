NODE_ENV=development
PORT=8080

# System DB
# The database must already exist before backend startup.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=Zaq123@@
DB_NAME=salesplatform_system

# Tenant DB defaults (used when provisioning or connecting tenant databases)
TENANT_DB_HOST=localhost
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=Zaq123@@

# Default seed data
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@platform.com
SEED_SUPER_ADMIN_PASSWORD=Admin@12345!

# JWT - generate with: openssl rand -base64 64
JWT_SECRET=your_256bit_base64_secret_here
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# AES key for encrypting tenant DB passwords (32 bytes hex)
TENANT_DB_PASSWORD_KEY=your_aes256_key_here

FRONTEND_URL=http://localhost:5173

# Upstash Redis Cache
UPSTASH_REDIS_REST_URL=https://driven-redbird-113994.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ===== Chatbot AI (CDSoft Assistant) =====
# Toggle whole feature on/off
CHATBOT_ENABLED=true

# OpenAI (chat + embeddings). Required to enable LLM responses.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-5-nano
# CHATBOT_MODEL=gpt-5.4-mini
CHATBOT_EMBEDDING_MODEL=text-embedding-3-small
CHATBOT_EMBEDDING_DIMENSION=1536
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_TOOL_ITERATIONS=5

# Daily quotas (reset 00:00 UTC). Counter stored in Upstash Redis.
CHATBOT_DAILY_GLOBAL_LIMIT=20000
CHATBOT_DAILY_PER_USER_LIMIT=200

# OpenSearch (Aiven or self-hosted). RAG features become disabled when blank.
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=cdsoft_knowledge_base
OPENSEARCH_TOP_K=5

CHATBOT_FAST_MODEL=gpt-5-nano
CHATBOT_UNCERTAIN_MODEL=gpt-5.4-nano
CHATBOT_COMPLEX_MODEL=gpt-5.4-mini
